<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hoehmann.salesbot">

    <uses-permission android:name="com.robotemi.permission.ROBOT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.robotemi.sdk.action.sequence" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Kiosk mode -->
            <meta-data
                android:name="com.robotemi.sdk.metadata.KIOSK"
                android:value="TRUE" />
        </activity>

        <!-- Temi permissions metadata -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.permission.face_recognition"
            android:value="TRUE" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.permission.map"
            android:value="TRUE" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.permission.settings"
            android:value="TRUE" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.permission.sequence"
            android:value="TRUE" />

    </application>

</manifest>
